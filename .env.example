# Copie este arquivo para .env e preencha com seus próprios valores.
# Nunca commite o .env de verdade — ele fica no .gitignore de propósito.

# DATABASE_URL="postgres://usuario:senha@localhost:5432/gerencie_se"
DATABASE_URL="postgresql://postgres:dev123@localhost:5432/gerencie_se"
# Gere um valor aleatório: `openssl rand -base64 32`
AUTH_SECRET=""

# OAuth do Google — login (ver docs/GOOGLE_SETUP.md)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OAuth do Google — Google Agenda (escopo separado do login)
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"
# Criptografa os tokens do Google Agenda em repouso (nunca ficam em texto
# puro no banco). Gere com: `openssl rand -base64 32`. Trocar esse valor
# depois de configurado invalida conexões existentes (usuário precisa
# reconectar o Google Agenda).
TOKEN_ENCRYPTION_KEY=""

# E-mail transacional (convites, recuperação de senha, alerta de login,
# resumo semanal) via SMTP do Gmail — ver docs/EMAIL_SETUP.md. Sem essas
# duas variáveis, o app funciona normalmente, só não envia e-mail.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# URL pública do app, usada para montar o link dentro do e-mail de convite.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protege /api/cron/weekly-summary e /api/cron/send-push-reminders. Sem
# essa variável, as rotas sempre recusam — os envios automáticos ficam
# desligados até você configurar um agendador externo (cron-job.org etc.)
# que chame a rota com "Authorization: Bearer <mesmo valor>".
CRON_SECRET=""

# Notificação push (Web Push) — ver docs/DEPLOY.md, seção 7b. Opcional:
# sem isso, o botão "Ativar notificações neste aparelho" some sozinho.
# Gere com: `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
