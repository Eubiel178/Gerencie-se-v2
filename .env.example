# Copie este arquivo para .env e preencha com seus próprios valores.
# Nunca commite o .env de verdade — ele fica no .gitignore de propósito.

# DATABASE_URL="postgres://usuario:senha@localhost:5432/gerencie_se"
DATABASE_URL="postgresql://postgres:dev123@localhost:5432/gerencie_se"
# Gere um valor aleatório: `openssl rand -base64 32`
AUTH_SECRET=""

# OAuth do Google — login (ver docs/GOOGLE_SETUP.md)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OAuth do Google — Google Agenda (escopo separado do login)
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"

# E-mail transacional (convites de compartilhamento) — ver docs/EMAIL_SETUP.md.
# Sem essa chave, o app funciona normalmente, só não envia o e-mail de
# convite (o vínculo ainda é criado e aparece pra pessoa convidada quando
# ela entrar/criar conta com o mesmo e-mail).
RESEND_API_KEY=""
# URL pública do app, usada para montar o link dentro do e-mail de convite.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protege /api/cron/weekly-summary (resumo semanal por e-mail). Sem essa
# variável, a rota sempre recusa — o envio automático fica desligado até
# você configurar um agendador externo (Vercel Cron, GitHub Actions etc.)
# que chame a rota com "Authorization: Bearer <mesmo valor>".
CRON_SECRET=""
